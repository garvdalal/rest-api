if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python high_level_python_projects.py [crawl|serve]")
        sys.exit(1)

    command = sys.argv[1].lower()

    if command == "crawl":
        pages = run_crawler()
        analyze_web_data(pages)

    elif command == "serve":
        run_api_server()

    else:
        print(f"Unknown command: {command}")
        print("Available commands: crawl, serve")
